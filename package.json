{
  "name": "dsh-paste-image",
  "version": "0.4.3",
  "description": "Paste any image into DeepSeek Harness: converts XPM/BMP/DIB/SVG/TIFF/etc. and MIME-lying images to PNG, JPEG or WebP (PNG by default) in the renderer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "clipboard",
    "paste",
    "image",
    "xpm",
    "bmp",
    "dib",
    "svg",
    "png",
    "wayland",
    "i18n",
    "localization",
    "multilingual"
  ],
  "private": false,
  "icon": "./assets/icon-180.png",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "lib",
    "locale/*.json",
    "assets/icon-180.png",
    "cordis.patch.yml",
    "README*.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bench": "node bench/bench.mjs",
    "check": "node --check client.js && node --check lib/index.js",
    "format": "npx --yes prettier@3 --write .",
    "format:check": "npx --yes prettier@3 --check .",
    "prepublishOnly": "npm test && npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengtang1024/dsh-paste-image.git"
  },
  "bugs": {
    "url": "https://github.com/pengtang1024/dsh-paste-image/issues"
  },
  "homepage": "https://github.com/pengtang1024/dsh-paste-image#readme",
  "author": "pengtang1024",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "license": "MIT"
}
